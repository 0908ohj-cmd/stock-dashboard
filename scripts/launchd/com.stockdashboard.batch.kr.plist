<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stockdashboard.batch.kr</string>
  <key>ProgramArguments</key>
  <array>
    <!-- stockEdge job_wrapper 경유 — jobs.db(/jobs 탭) 기록, 실패 시 텔레그램, catchup 재시도.
         작업 정의: stockEdge scripts/jobs_defs.py 의 stock-dashboard-kr (cron이 아래 시각과 같아야 한다) -->
    <string>/Users/ygun/Workspace/stockEdge/tools/job_wrapper.sh</string>
    <string>stock-dashboard-kr</string>
    <string>scheduled</string>
    <string>/Users/ygun/Workspace/stock-dashboard-batch/scripts/run_batch_local.sh</string>
    <string>kr</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/ygun/Library/Logs/stock-dashboard-batch.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ygun/Library/Logs/stock-dashboard-batch.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
